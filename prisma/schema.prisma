generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  friendCode   String   @unique
  createdAt    DateTime @default(now())

  createdSessions Session[]      @relation("SessionCreator")
  entries         SessionEntry[]
  rebuysAsBuyer   Rebuy[]        @relation("RebuyBuyer")
  rebuySharesSold RebuyShare[]   @relation("RebuyShareSeller")
  settlementsPay  Settlement[]   @relation("SettlementFrom")
  settlementsGet  Settlement[]   @relation("SettlementTo")
  friendsAdded    Friendship[]   @relation("FriendOwner")
  addedByFriends  Friendship[]   @relation("FriendTarget")
}

// One-directional: userId added friendId as a friend. No approval step —
// consistent with the rest of the app (friend codes, no accept/reject flows).
// See docs/spec-friends.md.
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("FriendOwner", fields: [userId], references: [id])
  friendId  String
  friend    User     @relation("FriendTarget", fields: [friendId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

// No persistent "group": a session is just its creator (the organizer, 幹事)
// plus whichever of their friends they invited for that occasion. See
// docs/spec-friends.md for why the earlier Group/GroupMember model was
// removed in favor of a friends-only model.
model Session {
  id          String    @id @default(cuid())
  sessionDate DateTime
  location    String?
  status      String    @default("draft") // "draft" | "confirmed"
  createdById String
  createdBy   User      @relation("SessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  entries     SessionEntry[]
  rebuys      Rebuy[]
  settlements Settlement[]
}

model SessionEntry {
  id           String  @id @default(cuid())
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  initialStake Int
  cashOut      Int?

  @@unique([sessionId, userId])
}

// A single rebuy: one buyer, one or more sellers (rebuy_shares).
model Rebuy {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("RebuyBuyer", fields: [buyerId], references: [id])
  createdAt DateTime @default(now())

  shares RebuyShare[]
}

model RebuyShare {
  id       String @id @default(cuid())
  rebuyId  String
  rebuy    Rebuy  @relation(fields: [rebuyId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("RebuyShareSeller", fields: [sellerId], references: [id])
  amount   Int

  @@unique([rebuyId, sellerId])
}

model Settlement {
  id         String  @id @default(cuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User    @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User    @relation("SettlementTo", fields: [toUserId], references: [id])
  amount     Int
  settled    Boolean @default(false)
}
